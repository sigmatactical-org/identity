#
# Host-native development: identity runs via `cargo run` on the host.
# Start dependencies: ./scripts/dev-stack.sh up && ./scripts/dev-stack.sh wait
#

IDENTITY_BIND_PORT=3000
IDENTITY_BIND_ADDRESS="::"
RUST_LOG=sigma_identity=debug,info

# Echo backend (published by docker-compose.host-dev.yml)
IDENTITY_PROXY_TARGET=http://127.0.0.1:8088/
IDENTITY_PROXY_TARGET_RULE_A=/num=>http://127.0.0.1:8088/rule/a
IDENTITY_PROXY_TARGET_RULE_FOO=/foo=>http://127.0.0.1:8088/foo-rule/abc
IDENTITY_PROXY_TARGET_RULE_BAR=/bar/me/no=>http://127.0.0.1:8088/bar/bar/bar

IDENTITY_SESSION_REFRESH_THRESHOLD=15

# Keycloak dev realm (port 8101 via dev-stack)
IDENTITY_OIDC_ISSUER_URL=http://127.0.0.1:8101/realms/multcorp
IDENTITY_OIDC_AUTH_URL=http://127.0.0.1:8101/realms/multcorp/protocol/openid-connect/auth
IDENTITY_OIDC_CLIENT_ID=identity
IDENTITY_OIDC_CLIENT_SECRET=8d476311-2577-4104-b9e4-7dc2cc381be8
IDENTITY_LOGOUT_SSO_URI=http://127.0.0.1:8101/realms/multcorp/protocol/openid-connect/logout

IDENTITY_DATABASE_URL=postgres://sigma:sigma@127.0.0.1:5432/sigma
IDENTITY_SESSION_SECRET=iIdh4cBut27H6Y5MCk9782bE3Nk56JVsahla1vhILE3tizmX5nP5riOhV8IgorzI
IDENTITY_SESSION_COOKIE_NAME=identity.sid
IDENTITY_SESSION_COOKIE_SAMESITE=lax

IDENTITY_LOGIN_REDIRECT_APP_URIS=http://localhost:3000/*,http://127.0.0.1:3000/*,http://localhost:8082/*,http://127.0.0.1:8082/*
IDENTITY_OIDC_REDIRECT_URIS=http://localhost:3000/auth/callback,http://127.0.0.1:3000/auth/callback
IDENTITY_LOGOUT_REDIRECT_APP_URIS=http://localhost:3000/exampleapp/
IDENTITY_LOGOUT_OIDC_REDIRECT_URIS=http://localhost:3000/auth/logoutcallback
