#
# Required options (IDENTITY_* preferred; RIDSER_* accepted as deprecated fallback)
#

IDENTITY_BIND_PORT=3000
IDENTITY_BIND_ADDRESS="::"
RUST_LOG=identity=debug,info
# Target for authenticated requests
IDENTITY_PROXY_TARGET=http://echo:3000/
# Deny refresh requests as long as the session is valid for longer than this threshold
IDENTITY_SESSION_REFRESH_THRESHOLD=15
# OpenID Connect Issuer
IDENTITY_OIDC_ISSUER_URL=http://localhost:8101/realms/multcorp
# Client with user data access
IDENTITY_OIDC_CLIENT_ID=identity
# Secret for client with user data access
IDENTITY_OIDC_CLIENT_SECRET=8d476311-2577-4104-b9e4-7dc2cc381be8
# Single sign on logout endpoint
IDENTITY_LOGOUT_SSO_URI=http://localhost:8101/realms/multcorp/protocol/openid-connect/logout
# Redis cache configuration
IDENTITY_REDIS_URL=redis://redis:6379
# Session secret, length in bytes: 64
IDENTITY_SESSION_SECRET=iIdh4cBut27H6Y5MCk9782bE3Nk56JVsahla1vhILE3tizmX5nP5riOhV8IgorzI

#
# Redirect allowlists
#

# Allowed post-login app destinations (exact or trailing-* wildcard)
IDENTITY_LOGIN_REDIRECT_APP_URIS=http://localhost:4800/*,http://localhost:4700/*,http://identity.localhost/,http://localhost:3000/*
# Allowed OAuth redirect_uri values sent to the IdP (must include this service's callback URL)
IDENTITY_OIDC_REDIRECT_URIS=http://localhost:3000/auth/callback,https://localhost:3000/auth/callback
# Allowed post-logout app destinations (exact match only)
IDENTITY_LOGOUT_REDIRECT_APP_URIS=http://localhost:4800/,http://localhost:3000/exampleapp/
# Allowed post_logout_redirect_uri values sent to the IdP (this service's logout callback)
IDENTITY_LOGOUT_OIDC_REDIRECT_URIS=http://localhost:3000/auth/logoutcallback,https://localhost:3000/auth/logoutcallback

#
# Optional

# Override authorization endpoint
IDENTITY_OIDC_AUTH_URL=http://localhost:8101/realms/multcorp/protocol/openid-connect/auth
# Override cookie name for session cookie. Default: identity.sid
IDENTITY_SESSION_COOKIE_NAME=identity.sid
# SameSite for session cookie. Default: lax. Valid: none, lax, strict
IDENTITY_SESSION_COOKIE_SAMESITE=lax

IDENTITY_PROXY_TARGET_RULE_A=/num=>http://echo:3000/rule/a
IDENTITY_PROXY_TARGET_RULE_FOO=/foo=>http://echo:3000/foo-rule/abc
IDENTITY_PROXY_TARGET_RULE_BAR=/bar/me/no=>http://echo:3000/bar/bar/bar
