IDENTITY_BIND_PORT=3000
IDENTITY_BIND_ADDRESS="::"
RUST_LOG=sigma_identity=trace
IDENTITY_PROXY_TARGET=http://echo:3000
IDENTITY_SESSION_REFRESH_THRESHOLD=15
# Keycloak is fronted by Traefik TLS; discover via the keycloak.localhost network alias.
IDENTITY_OIDC_ISSUER_URL=https://keycloak.localhost:8101/realms/multcorp
IDENTITY_OIDC_DISCOVERY_ISSUER_URL=https://keycloak.localhost:8101/realms/multcorp
IDENTITY_OIDC_CLIENT_ID=identity
IDENTITY_OIDC_CLIENT_SECRET=8d476311-2577-4104-b9e4-7dc2cc381be8
IDENTITY_LOGOUT_SSO_URI=https://keycloak.localhost:8101/realms/multcorp/protocol/openid-connect/logout
IDENTITY_DATABASE_URL=postgres://sigma:sigma@postgres:5432/sigma
IDENTITY_SESSION_SECRET=iIdh4cBut27H6Y5MCk9782bE3Nk56JVsahla1vhILE3tizmX5nP5riOhV8IgorzI
IDENTITY_DANGER_ACCEPT_INVALID_CERTS=true
IDENTITY_SESSION_COOKIE_NAME=identity.sid
IDENTITY_LOGIN_REDIRECT_APP_URIS=https://localhost:3000/*
IDENTITY_OIDC_REDIRECT_URIS=https://localhost:3000/auth/callback
IDENTITY_LOGOUT_REDIRECT_APP_URIS=https://localhost:3000/exampleapp/
IDENTITY_LOGOUT_OIDC_REDIRECT_URIS=https://localhost:3000/auth/logoutcallback
IDENTITY_PROXY_TARGET_RULE_A=/num=>http://echo:3000/rule/a
IDENTITY_PROXY_TARGET_RULE_FOO=/foo=>http://echo:3000/foo-rule/abc
IDENTITY_PROXY_TARGET_RULE_BAR=/bar/me/no=>http://echo:3000/bar/bar/bar
