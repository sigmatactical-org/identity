#
# Conformance stack: identity as RP, OpenID conformance suite as fake OP.
# Issuer URL is created when sigma-conformance bootstrap registers the test plan alias.
#

IDENTITY_CONFORMANCE_MODE=1
IDENTITY_BIND_PORT=3000
IDENTITY_BIND_ADDRESS=::
RUST_LOG=sigma_identity=debug,info
IDENTITY_PROXY_TARGET=http://echo:3000/
IDENTITY_SESSION_REFRESH_THRESHOLD=15
IDENTITY_OIDC_ISSUER_URL=https://localhost.emobix.co.uk:8443/test/a/sigma-identity/
IDENTITY_OIDC_CLIENT_ID=sigma-identity-conformance
IDENTITY_OIDC_CLIENT_SECRET=conformance-client-secret-not-for-production
IDENTITY_OIDC_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_post
IDENTITY_LOGOUT_SSO_URI=https://localhost.emobix.co.uk:8443/test/a/sigma-identity/logout
IDENTITY_REDIS_URL=redis://redis:6379/
IDENTITY_SESSION_SECRET=conformance-session-secret-64-bytes-minimum-length-required-for-cookie-key!!
IDENTITY_DANGER_ACCEPT_INVALID_CERTS=true
IDENTITY_SESSION_COOKIE_NAME=identity.sid
IDENTITY_LOGIN_REDIRECT_APP_URIS=https://localhost:3000/*
IDENTITY_OIDC_REDIRECT_URIS=https://localhost:3000/auth/callback
IDENTITY_LOGOUT_REDIRECT_APP_URIS=https://localhost:3000/conformance/
IDENTITY_LOGOUT_OIDC_REDIRECT_URIS=https://localhost:3000/auth/logoutcallback
