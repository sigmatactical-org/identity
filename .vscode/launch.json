{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug sigma-identity",
            "cargo": {
                "args": [
                    "build",
                    "--bin=sigma-identity",
                    "--package=sigma-identity"
                ],
                "filter": {
                    "name": "sigma-identity",
                    "kind": "bin"
                }
            },
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "RUST_LOG": "sigma_identity=debug,info"
            }
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug sigma-identity tests (lib)",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--lib",
                    "--package=sigma-identity"
                ],
                "filter": {
                    "name": "sigma_identity",
                    "kind": "lib"
                }
            },
            "args": [
                "auth::status::tests::test_handles_authenticated_state",
                "--nocapture"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "RUST_LOG": "sigma_identity=debug,info",
                "RUST_BACKTRACE": "1",
                "TEST_DATABASE_URL": "postgres://sigma:sigma@127.0.0.1:5432/sigma"
            }
        }
    ]
}
