{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug executable 'sigma-identity'",
            "cargo": {
                "args": [
                    "build",
                    "--bin=sigma-identity",
                    "--package=sigma-identity"
                ],
                "filter": {
                    "name": "sigma-identity",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug unit tests in executable 'sigma-identity'",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--bin=sigma-identity",
                    "--package=sigma-identity"
                ],
                "filter": {
                    "name": "sigma-identity",
                    "kind": "bin"
                }
            },
            "args": [
                "auth::status::tests::test_handles_authenticated_state"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "RUST_LOG": "sigma_identity=debug,info",
                "IDENTITY_TEST_REDIS_URL": "localhost:6379"
            }
        }
    ]
}
