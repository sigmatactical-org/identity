{
  "alias": "sigma-identity",
  "description": "sigma-identity/{VERSION} RP-initiated logout",
  "publish": "no",
  "client": {
    "client_id": "{CLIENT_ID}",
    "client_secret": "{CLIENT_SECRET}",
    "redirect_uris": ["https://localhost:3000/auth/callback"],
    "post_logout_redirect_uris": ["https://localhost:3000/conformance/"],
    "scope": "openid profile email"
  }
}
